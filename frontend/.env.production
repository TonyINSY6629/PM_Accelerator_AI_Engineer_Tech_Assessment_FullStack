# Baked into the bundle at build time, so a change here needs a rebuild.
# Not a secret: this is a public URL, which is why the file is committed.
#
# Moved from Render to Fly.io because Render's free tier shares an outbound IP
# address between customers, and Open-Meteo rate-limits by IP, so the deployment
# received HTTP 429 for traffic that was not its own.
VITE_WEATHER_API_BASE=https://pm-accelerator-ai-engineer-assessment-full-stack.fly.dev
